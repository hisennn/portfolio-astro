---
import ProjectOverview from "../../components/ProjectOverview.astro";
import BaseLayout from "../../layouts/BaseLayout.astro";
import PageChrome from "../../components/PageChrome";
import ProjectMedia from "../../components/ProjectMedia.astro";
import ProjectImage from "../../components/ProjectImage.astro";
import ProjectImageViewer from "../../components/ProjectImageViewer.astro";
import ProjectNav from "../../components/ProjectNav.astro";
import feedImage from "../../assets/projects/kiromilog/feed.png";
import profileImage from "../../assets/projects/kiromilog/profile.png";

const title = "Kiromilog | Projeto de Gabriel Lemes";
const description =
  "Kiromilog é uma aplicação para acompanhar animes e mangás, desenvolvida por Gabriel Lemes com Next.js, TypeScript, Neon e Jikan API.";
const tech = [
  "Next.js 16",
  "TypeScript",
  "Neon Auth",
  "Neon Postgres",
  "Drizzle",
  "UploadThing",
  "Pusher",
  "Jikan API",
];
const jsonLd = {
  "@context": "https://schema.org",
  "@type": "SoftwareApplication",
  name: "Kiromilog",
  applicationCategory: "EntertainmentApplication",
  operatingSystem: "Web",
  url: "https://gabriellemes.com/projects/kiromilog/",
  sameAs: "https://kiromilog.vercel.app/",
  author: {
    "@type": "Person",
    name: "Gabriel Lemes",
    url: "https://gabriellemes.com",
  },
};
---

<BaseLayout
  title={title}
  description={description}
  canonicalPath="/projects/kiromilog/"
  imageAlt="Kiromilog social anime and manga tracker project"
  jsonLd={jsonLd}
>
  <PageChrome client:load>
    <main class="project-detail-main">
      <div class="project-detail-hero">
        <article class="project-detail-intro">
          <div class="project-detail-heading">
            <h1>Kiromilog</h1>
            <p class="project-detail-lead">
              <span data-lang="pt">
                Criei o Kiromilog para acompanhar animes e mangás, com listas,
                busca, perfis, seguidores, favoritos e mensagens.
              </span>
              <span data-lang="en">
                I built Kiromilog to track anime and manga, with lists, search,
                profiles, follows, favorites, and messages.
              </span>
            </p>
            <a
              class="project-detail-visit"
              href="https://kiromilog.vercel.app/"
              target="_blank"
              rel="noopener noreferrer"
            >
              <span data-lang="pt">Abrir projeto</span>
              <span data-lang="en">Open project</span>
              <span aria-hidden="true"><i class="ph ph-arrow-up-right"></i></span>
            </a>
          </div>

          <aside class="project-detail-meta" aria-label="Project details">
            <div class="project-detail-meta-row">
              <span class="project-detail-meta-label"><span data-lang="pt">Tecnologias</span><span data-lang="en">Technologies</span></span>
              <div class="project-detail-tech">
                {tech.join(", ")}
              </div>
            </div>
          </aside>
        </article>
      </div>

      <ProjectOverview>
          <ul>
            <li>
              <span data-lang="pt">Busca de anime, mangá, personagens e usuários com dados da Jikan API.</span>
              <span data-lang="en">Search for anime, manga, characters, and users with data from the Jikan API.</span>
            </li>
            <li>
              <span data-lang="pt">Perfis com listas, favoritos, seguidores e histórico de atividade.</span>
              <span data-lang="en">Profiles with lists, favorites, followers, and activity history.</span>
            </li>
            <li>
              <span data-lang="pt">Autenticação e dados com Neon Auth, PostgreSQL e Drizzle.</span>
              <span data-lang="en">Authentication and data with Neon Auth, PostgreSQL, and Drizzle.</span>
            </li>
            <li>
              <span data-lang="pt">Upload de avatar, mensagens e atualizações em tempo real.</span>
              <span data-lang="en">Avatar uploads, messages, and real-time updates.</span>
            </li>
          </ul>
      </ProjectOverview>

      <div class="project-detail-gallery">
        <ProjectMedia
          titlePt="Busca e catálogo"
          titleEn="Search and catalog"
          descriptionPt="Pesquisa por anime, mangá, personagens e usuários, com resultados separados por tipo."
          descriptionEn="Search across anime, manga, characters, and users, with results separated by type."
        >
          <video
            data-project-video
            muted
            loop
            playsinline
            controls
            preload="metadata"
            width="1920"
            height="1080"
          >
            <source src="/projects/kiromilog/search-and-catalog.mp4" type="video/mp4" />
          </video>
        </ProjectMedia>

        <ProjectMedia
          titlePt="Perfis e conexões"
          titleEn="Profiles and connections"
          descriptionPt="Busca de usuários e fluxo de seguir perfis, refletindo as conexões no feed."
          descriptionEn="User search and profile following, with those connections reflected in the feed."
        >
          <video
            data-project-video
            muted
            loop
            playsinline
            controls
            preload="metadata"
            width="1920"
            height="1080"
          >
            <source src="/projects/kiromilog/profiles-and-follows.mp4" type="video/mp4" />
          </video>
        </ProjectMedia>

        <ProjectMedia
          titlePt="Perfil e biblioteca"
          titleEn="Profile and library"
          descriptionPt="Listas, estatísticas, favoritos e histórico de atividade reunidos no perfil."
          descriptionEn="Lists, statistics, favorites, and activity history collected in the profile."
        >
          <ProjectImage
            src={profileImage}
            alt="Kiromilog profile page with anime and manga statistics, favorites, and activity history"
            widths={[640, 960, 1400, 2168]}
            sizes="(min-width: 1100px) 1200px, (min-width: 900px) 85vw, calc(100vw - 40px)"
          />
        </ProjectMedia>

        <ProjectMedia
          titlePt="Feed de atividade"
          titleEn="Activity feed"
          descriptionPt="Atividades recentes de quem o usuário segue, com progresso, favoritos e itens em andamento."
          descriptionEn="Recent activity from followed users, including progress, favorites, and current items."
        >
          <ProjectImage
            src={feedImage}
            alt="Kiromilog activity feed with recent anime and manga updates"
            widths={[640, 960, 1400, 2168]}
            sizes="(min-width: 1100px) 1200px, (min-width: 900px) 85vw, calc(100vw - 40px)"
          />
        </ProjectMedia>
      </div>

      <ProjectNav
        prevHref="/projects/brc-client-portal/"
        prevPt="BRC Client Portal"
        prevEn="BRC Client Portal"
        nextHref="/projects/baltimore-reconstruction/"
        nextPt="Baltimore Re-Construction"
        nextEn="Baltimore Re-Construction"
      />
    </main>
    <ProjectImageViewer />

    <script is:inline>
      var reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
      document.querySelectorAll("[data-project-video]").forEach(function (video) {
        if (!reduceMotion) {
          video.play().catch(function () {});
        }
      });
    </script>
  </PageChrome>
</BaseLayout>
