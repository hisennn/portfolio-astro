---
import ProjectOverview from "../../components/ProjectOverview.astro";
import ProjectIntro from "../../components/ProjectIntro.astro";
import BaseLayout from "../../layouts/BaseLayout.astro";
import PageChrome from "../../components/PageChrome";
import ProjectMedia from "../../components/ProjectMedia.astro";
import ProjectImage from "../../components/ProjectImage.astro";
import ProjectImageViewer from "../../components/ProjectImageViewer.astro";
import ProjectNav from "../../components/ProjectNav.astro";
import homeImage from "../../assets/projects/isadora-tomazini/home.png";
import contactImage from "../../assets/projects/isadora-tomazini/contact.png";

const title = "Isadora Tomazini | Projeto de Gabriel Lemes";
const description =
  "Site profissional desenvolvido para a psicóloga Isadora Tomazini, com apresentação do atendimento, áreas de atuação e contato.";
const tech = ["Astro", "JavaScript", "CSS"];
const imageWidths = [640, 960, 1400, 2175];
const imageSizes = "(min-width: 1100px) 1200px, (min-width: 900px) 85vw, calc(100vw - 40px)";
const jsonLd = {
  "@context": "https://schema.org",
  "@type": "WebSite",
  name: "Isadora Tomazini Psicóloga",
  url: "https://isadoratomazini.com.br/",
  creator: {
    "@type": "Person",
    name: "Gabriel Lemes",
    url: "https://gabriellemes.com",
  },
};
---

<BaseLayout
  title={title}
  description={description}
  canonicalPath="/projects/isadora-tomazini/"
  imageAlt="Isadora Tomazini psychologist website project"
  jsonLd={jsonLd}
>
  <PageChrome client:load>
    <main class="project-detail-main">
      <ProjectIntro>
      <div class="project-detail-hero">
        <article class="project-detail-intro">
          <div class="project-detail-heading">
            <h1>Isadora Tomazini</h1>
            <p class="project-detail-lead">
              <span data-lang="pt">
                Criei o site para apresentar o trabalho da psicóloga, explicar suas
                áreas de atuação e facilitar o primeiro contato.
              </span>
              <span data-lang="en">
                I built the website to present the psychologist's work, explain her
                areas of practice, and make it easy to get in touch.
              </span>
            </p>
            <a
              class="project-detail-visit"
              href="https://isadoratomazini.com.br/"
              target="_blank"
              rel="noopener noreferrer"
            >
              <span data-lang="pt">Abrir site</span>
              <span data-lang="en">Open website</span>
              <span aria-hidden="true"><i class="ph ph-arrow-up-right"></i></span>
            </a>
          </div>

          <aside class="project-detail-meta" aria-label="Project details">
            <div class="project-detail-meta-row">
              <span class="project-detail-meta-label"><span data-lang="pt">Tecnologias</span><span data-lang="en">Technologies</span></span>
              <div class="project-detail-tech">
                {tech.join(", ")}
              </div>
            </div>
          </aside>
        </article>
      </div>

      <ProjectOverview>
          <ul>
            <li>
              <span data-lang="pt">Áreas de atuação organizadas em acordeões.</span>
              <span data-lang="en">Areas of practice organized in accordions.</span>
            </li>
            <li>
              <span data-lang="pt">Página dedicada à trajetória e abordagem profissional.</span>
              <span data-lang="en">Dedicated page for professional background and approach.</span>
            </li>
            <li>
              <span data-lang="pt">WhatsApp, e-mail e formulário reunidos na página de contato.</span>
              <span data-lang="en">WhatsApp, email, and a form gathered on the contact page.</span>
            </li>
          </ul>
      </ProjectOverview>
      </ProjectIntro>

      <div class="project-detail-gallery">
        <ProjectMedia
          titlePt="Apresentação e áreas de atuação"
          titleEn="Introduction and areas of practice"
          descriptionPt="Página inicial com proposta de atendimento, chamada para contato e temas trabalhados."
          descriptionEn="Home page with the care approach, contact call to action, and key topics."
        >
          <ProjectImage
            src={homeImage}
            alt="Página inicial do site da psicóloga Isadora Tomazini"
            widths={imageWidths}
            sizes={imageSizes}
          />
        </ProjectMedia>

        <ProjectMedia
          titlePt="Contato direto"
          titleEn="Direct contact"
          descriptionPt="Canais de atendimento e formulário organizados em uma única página."
          descriptionEn="Contact channels and inquiry form organized on a single page."
        >
          <ProjectImage
            src={contactImage}
            alt="Página de contato do site da psicóloga Isadora Tomazini"
            widths={imageWidths}
            sizes={imageSizes}
          />
        </ProjectMedia>
      </div>

      <ProjectNav
        prevHref="/projects/ana-zabala/"
        prevPt="Ana Zabala Portfolio"
        prevEn="Ana Zabala Portfolio"
        nextHref="/projects/coordinate-saver/"
        nextPt="Coordinate Saver"
        nextEn="Coordinate Saver"
      />
    </main>
    <ProjectImageViewer />
  </PageChrome>
</BaseLayout>
