---
import BaseLayout from "../layouts/BaseLayout.astro";
import App from "../App";
import { getImage } from "astro:assets";
import type { ProjectPreviews } from "../components/Projects";
import brc from "../assets/projects/brc-portal/dashboard.png";
import kiromilog from "../assets/projects/kiromilog/feed.png";
import baltimore from "../assets/projects/baltimore-reconstruction/services.webp";
import ana from "../assets/projects/ana-zabala/project-list.webp";
import isadora from "../assets/projects/isadora-tomazini/home.png";
import coordinates from "../assets/projects/coordinate-saver/overview.png";

import brcWorkspace from "../assets/projects/brc-portal/project-workspace.png";
import brcThemes from "../assets/projects/brc-portal/interface-themes.png";
import kiromilogProfile from "../assets/projects/kiromilog/profile.png";
import baltimoreWork from "../assets/projects/baltimore-reconstruction/work.webp";
import baltimoreContact from "../assets/projects/baltimore-reconstruction/contact.webp";
import anaDetail from "../assets/projects/ana-zabala/project-detail.webp";
import anaTheme from "../assets/projects/ana-zabala/theme-light.webp";
import isadoraContact from "../assets/projects/isadora-tomazini/contact.png";

const projectPreviews = Object.fromEntries(
  await Promise.all(
    Object.entries({
      brc: [brc, brcWorkspace, brcThemes],
      kiromilog: [kiromilog, kiromilogProfile],
      baltimore: [baltimore, baltimoreWork, baltimoreContact],
      ana: [ana, anaDetail, anaTheme],
      isadora: [isadora, isadoraContact],
      coordinates: [coordinates],
    }).map(async ([key, sources]) => [key, await Promise.all(sources.map(async (src) => {
      const image = await getImage({ src, width: 1200, height: 750, fit: "contain", background: "#eceef1", format: "webp", quality: 80 });
      return image.src;
    }))])
  )
) as ProjectPreviews;

const title = "Gabriel Lemes | Full-Stack Web Developer";
const description =
  "Portfólio de Gabriel Lemes, desenvolvedor web full stack em Batatais, SP. Aplicações web, sistemas internos, sites institucionais e projetos para clientes.";
const jsonLd = {
  "@context": "https://schema.org",
  "@type": "Person",
  name: "Gabriel Lemes",
  url: "https://gabriellemes.com",
  jobTitle: "Full-Stack Web Developer",
  address: {
    "@type": "PostalAddress",
    addressLocality: "Batatais",
    addressRegion: "SP",
    addressCountry: "BR",
  },
  email: "mailto:gabrielsilvarz@outlook.com",
  sameAs: [
    "https://www.linkedin.com/in/gabrieldslemes/",
    "https://github.com/Hisennn",
  ],
  knowsAbout: [
    "Frontend Development",
    "React",
    "TypeScript",
    "Astro",
    "Next.js",
    "Cloudflare",
  ],
};
---

<BaseLayout title={title} description={description} jsonLd={jsonLd}>
  <App client:load projectPreviews={projectPreviews} />
</BaseLayout>
