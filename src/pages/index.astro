---
import "../styles/global.css";
import App from "../App";

const siteUrl = "https://gabriellemes.com";
const title = "Gabriel Lemes | Web Developer";
const description =
  "Portfolio de Gabriel Lemes, desenvolvedor web em Batatais, SP. Projetos em React, TypeScript, Astro, Next.js, Cloudflare e interfaces web.";
const imageUrl = `${siteUrl}/og-image.svg`;
const jsonLd = {
  "@context": "https://schema.org",
  "@type": "Person",
  name: "Gabriel Lemes",
  url: siteUrl,
  jobTitle: "Web Developer",
  address: {
    "@type": "PostalAddress",
    addressLocality: "Batatais",
    addressRegion: "SP",
    addressCountry: "BR",
  },
  email: "mailto:gabrielsilvarz@outlook.com",
  sameAs: [
    "https://www.linkedin.com/in/gabrieldslemes/",
    "https://github.com/Hisennn",
  ],
  knowsAbout: [
    "Frontend Development",
    "React",
    "TypeScript",
    "Astro",
    "Next.js",
    "Cloudflare",
  ],
};
---

<!doctype html>
<html lang="pt-BR" data-theme="dark" class="theme-loading">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="author" content="Gabriel Lemes" />
    <meta name="robots" content="index, follow" />
    <meta name="theme-color" content="#0a0a0a" />
    <meta name="color-scheme" content="dark light" />
    <meta http-equiv="Content-Language" content="pt-BR, en" />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="pt_BR" />
    <meta property="og:locale:alternate" content="en_US" />
    <meta property="og:site_name" content="Gabriel Lemes" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={siteUrl} />
    <meta property="og:image" content={imageUrl} />
    <meta property="og:image:type" content="image/svg+xml" />
    <meta
      property="og:image:alt"
      content="Gabriel Lemes web developer portfolio"
    />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={imageUrl} />
    <title>{title}</title>
    <script is:inline>
      (function () {
        var root = document.documentElement;
        try {
          var t = localStorage.getItem("theme");
          root.setAttribute("data-theme", t === "light" ? "light" : "dark");
        } catch (_) {
          root.setAttribute("data-theme", "dark");
        }

        function unlockTransitions() {
          requestAnimationFrame(function () {
            root.classList.remove("theme-loading");
          });
        }

        if (document.readyState === "loading") {
          document.addEventListener("DOMContentLoaded", unlockTransitions);
        } else {
          unlockTransitions();
        }

        setTimeout(unlockTransitions, 100);
      })();
    </script>
    <link rel="canonical" href={siteUrl} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Hanken+Grotesk:wght@400;500&display=swap"
    />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg?v=2.2" />
    <link rel="sitemap" href="/sitemap.xml" />
    <link
      rel="stylesheet"
      type="text/css"
      href="https://cdn.jsdelivr.net/gh/devicons/devicon@latest/devicon.min.css"
    />
    <link
      rel="stylesheet"
      href="https://cdn.boxicons.com/3.0.8/fonts/basic/boxicons.min.css"
    />
    <link
      rel="stylesheet"
      href="https://cdn.boxicons.com/3.0.8/fonts/filled/boxicons-filled.min.css"
    />
    <link
      rel="stylesheet"
      href="https://cdn.boxicons.com/3.0.8/fonts/brands/boxicons-brands.min.css"
    />
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  </head>
  <body class="antialiased">
    <App client:load />
  </body>
</html>
