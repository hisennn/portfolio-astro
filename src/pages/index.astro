---
import BaseLayout from "../layouts/BaseLayout.astro";
import App from "../App";

const title = "Gabriel Lemes | Web Developer";
const description =
  "Portfólio de Gabriel Lemes, desenvolvedor web em Batatais, SP. Sistemas internos, sites institucionais e projetos para clientes.";
const jsonLd = {
  "@context": "https://schema.org",
  "@type": "Person",
  name: "Gabriel Lemes",
  url: "https://gabriellemes.com",
  jobTitle: "Web Developer",
  address: {
    "@type": "PostalAddress",
    addressLocality: "Batatais",
    addressRegion: "SP",
    addressCountry: "BR",
  },
  email: "mailto:gabrielsilvarz@outlook.com",
  sameAs: [
    "https://www.linkedin.com/in/gabrieldslemes/",
    "https://github.com/Hisennn",
  ],
  knowsAbout: [
    "Frontend Development",
    "React",
    "TypeScript",
    "Astro",
    "Next.js",
    "Cloudflare",
  ],
};
---

<BaseLayout title={title} description={description} jsonLd={jsonLd}>
  <App client:load />
</BaseLayout>
