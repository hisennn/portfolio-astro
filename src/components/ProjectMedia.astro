---
type Props = {
  titlePt: string;
  titleEn: string;
  descriptionPt: string;
  descriptionEn: string;
};

const { titlePt, titleEn, descriptionPt, descriptionEn } = Astro.props;
---

<section class="project-detail-media-row">
  <header class="project-detail-media-copy">
    <div>
      <h2>
        <span data-lang="pt">{titlePt}</span>
        <span data-lang="en">{titleEn}</span>
      </h2>
      <p>
        <span data-lang="pt">{descriptionPt}</span>
        <span data-lang="en">{descriptionEn}</span>
      </p>
    </div>
  </header>
  <div class="project-detail-media-frame">
    <slot />
  </div>
</section>
