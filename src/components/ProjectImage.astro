---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";

type Props = {
  src: ImageMetadata;
  alt: string;
  widths: number[];
  sizes: string;
};

const { src, alt, widths, sizes } = Astro.props;
---

<button
  class="project-image-trigger"
  type="button"
  data-project-image-trigger
  data-project-image-src={src.src}
  data-project-image-alt={alt}
>
  <span class="sr-only">
    <span data-lang="pt">Ampliar imagem</span>
    <span data-lang="en">Enlarge image</span>
  </span>
  <Image
    src={src}
    alt={alt}
    widths={widths}
    sizes={sizes}
    format="webp"
    quality="max"
  />
</button>
