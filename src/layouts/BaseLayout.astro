---
import "../styles/global.css";

type Props = {
  title: string;
  description: string;
  canonicalPath?: string;
  image?: string;
  imageType?: string;
  imageAlt?: string;
  jsonLd?: Record<string, unknown>;
};

const siteUrl = "https://gabriellemes.com";
const {
  title,
  description,
  canonicalPath = "/",
  image = "/og-image.svg",
  imageType = "image/svg+xml",
  imageAlt = "Gabriel Lemes web developer portfolio",
  jsonLd,
} = Astro.props;
const canonicalUrl = new URL(canonicalPath, siteUrl).toString();
const imageUrl = image.startsWith("http") ? image : new URL(image, siteUrl).toString();
---

<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="author" content="Gabriel Lemes" />
    <meta name="robots" content="index, follow" />
    <meta name="theme-color" content="#001080" />
    <meta name="color-scheme" content="light" />
    <meta http-equiv="Content-Language" content="pt-BR, en" />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="pt_BR" />
    <meta property="og:locale:alternate" content="en_US" />
    <meta property="og:site_name" content="Gabriel Lemes" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={imageUrl} />
    {imageType && <meta property="og:image:type" content={imageType} />}
    <meta property="og:image:alt" content={imageAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={imageUrl} />
    <title>{title}</title>
    <script is:inline>
      (function () {
        var root = document.documentElement;
        try {
          var language = localStorage.getItem("language");
          root.setAttribute("lang", language === "en" ? "en" : "pt-BR");
        } catch (_) {
          root.setAttribute("lang", "pt-BR");
        }

      })();
    </script>
    <link rel="canonical" href={canonicalUrl} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Asap:ital,wght@0,400..800;1,400..800&family=Encode+Sans+Condensed:wght@400;500;600;700;800;900&display=swap"
    />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg?v=2.2" />
    <link rel="sitemap" href="/sitemap.xml" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/gh/devicons/devicon@latest/devicon.min.css" />
    <link
      rel="stylesheet"
      href="https://cdn.jsdelivr.net/npm/@phosphor-icons/web@2.1.2/src/regular/style.css"
    />
    {jsonLd && <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}
  </head>
  <body class="antialiased">
    <slot />
  </body>
</html>
